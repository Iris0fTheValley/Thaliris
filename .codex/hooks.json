{
  "description": "Thaliris managed intent-audit hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context audit-hook SessionStart",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context audit-hook UserPromptSubmit",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context audit-hook PostToolUse",
            "timeout": 60
          }
        ],
        "matcher": "^(?:spawn_agent|Agent|followup_task|send_input|send_message|(?:[A-Za-z0-9_]+\\.)+(?:spawn_agent|Agent|followup_task|send_input|send_message))$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context audit-hook Stop",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context audit-hook PreToolUse",
            "timeout": 60
          }
        ],
        "matcher": "^(?:spawn_agent|(?:[A-Za-z0-9_]+\\.)+spawn_agent)$"
      }
    ]
  }
}
